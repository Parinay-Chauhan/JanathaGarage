# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Firebase Web App Configuration (From Firebase Console > Project Settings > General > Your Apps > Web App)
# Note: Adding VITE_FIREBASE_API_KEY activates live SMS dispatch via Firebase Phone Auth
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=jantagaraj.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jantagaraj
VITE_FIREBASE_STORAGE_BUCKET=jantagaraj.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
