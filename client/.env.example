# ==============================================================
# JANTAGARAJ FRONTEND ENVIRONMENT CONFIGURATION (VERCEL DEPLOYMENT)
# ==============================================================

# Backend API Base URL (Render Web Service URL with /api/v1)
# Example: https://jantagaraj-server.onrender.com/api/v1
VITE_API_BASE_URL=https://jantagaraj-server.onrender.com/api/v1

# Firebase Web App Configuration (From Firebase Console > Project Settings > General > Your Apps > Web App)
# Note: Adding VITE_FIREBASE_API_KEY activates live SMS dispatch via Firebase Phone Auth
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=jantagaraj.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jantagaraj
VITE_FIREBASE_STORAGE_BUCKET=jantagaraj.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=523698534014
VITE_FIREBASE_APP_ID=1:523698534014:web:...
