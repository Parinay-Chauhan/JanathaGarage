# ==============================================================
# JANTAGARAJ BACKEND ENVIRONMENT CONFIGURATION (RENDER DEPLOYMENT)
# ==============================================================

# Server Port (Render sets this automatically, default 8000)
PORT=8000
NODE_ENV=production

# Database (Supabase PostgreSQL Connection Strings)
# Use transaction pooler URL (port 6543) for POSTGRES_URI and direct URL (port 5432) for DIRECT_URL
POSTGRES_URI="postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# CORS Allowed Origin (Set to your Vercel frontend URL)
CORS_ORIGIN=https://jantagaraj.vercel.app

# JWT Secrets for Authentication (Generate random 64-char strings)
ACCESS_TOKEN_SECRET=your_super_secret_access_jwt_key_here_64_chars_min
ACCESS_TOKEN_EXPIRATION=1d
REFRESH_TOKEN_SECRET=your_super_secret_refresh_jwt_key_here_64_chars_min
REFRESH_TOKEN_EXPIRATION=7d

# Firebase Admin SDK (From Firebase Console > Project Settings > Service Accounts > Generate new private key)
FIREBASE_PROJECT_ID=jantagaraj
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@jantagaraj.iam.gserviceaccount.com
# Note: Keep the exact private key with \n or escaped newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

